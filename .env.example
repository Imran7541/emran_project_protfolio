# Application Server Configuration
PORT=5225
NODE_ENV=production

# Autonomous AI Hub Path Integration
AI_AGENTS_HUB_PATH=/home/emran/Documents/AI-Agents-Hub

# Telemetry & Logging
LOG_LEVEL=info
ENABLE_RATE_LIMIT=true

# Stealth Admin Portal Security Passcode
ADMIN_MASTER_KEY=your_secure_master_passcode_here

# Google Gemini AI Integration (Shift-Left Backend Only)
GEMINI_API_KEY=[[YOUR_GEMINI_API_KEY]]
